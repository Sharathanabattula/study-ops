# Study-Ops configuration. Copy to .env (git-ignored): cp .env.example .env

# ── LLM provider: Anthropic Claude ───────────────────────────────────────────
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model used by every agent (default: claude-opus-5-5).
# STUDY_OPS_MODEL=claude-opus-5-5

# Set this if you authenticate with `ant auth login` instead of an API key.
# STUDY_OPS_PROVIDER=anthropic

# ── Workspace ────────────────────────────────────────────────────────────────
# Where data/, reports/ and output/ live. Defaults to the repo root.
# STUDY_OPS_HOME=/path/to/encrypted/volume

# Print stack traces on errors
# STUDY_OPS_DEBUG=1
