# Study-Ops configuration. Copy to .env (git-ignored): cp .env.example .env

# ── Claude access: pick ONE ──────────────────────────────────────────────────
# Option A (recommended): your Claude subscription (Pro/Max). Install Claude
# Code, run `claude` once and log in. Leave ANTHROPIC_API_KEY empty and
# Study-Ops uses it automatically through `claude -p`. Check with:
#   node bin/study-ops.js doctor
#
# Option B: pay-per-use API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Force a provider: claude-code (subscription) | api | off
# STUDY_OPS_PROVIDER=claude-code

# Subscription mode: Claude Code model alias (default: your Claude Code setting)
# STUDY_OPS_CLAUDE_MODEL=opus

# API mode: model id (default: claude-opus-5-5)
# STUDY_OPS_MODEL=claude-opus-5-5

# ── Workspace ────────────────────────────────────────────────────────────────
# Where data/, reports/ and output/ live. Defaults to the repo root.
# STUDY_OPS_HOME=/path/to/encrypted/volume

# Print stack traces on errors
# STUDY_OPS_DEBUG=1
