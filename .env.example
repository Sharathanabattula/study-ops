# Study-Ops configuration. Copy to .env (git-ignored).

# Where data/, reports/ and output/ live. Defaults to the repo root.
# STUDY_OPS_HOME=/path/to/encrypted/volume

# LLM provider: not wired yet (Phase 1.1). Reserved keys:
# STUDY_OPS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Print stack traces on errors
# STUDY_OPS_DEBUG=1
